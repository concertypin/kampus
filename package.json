{
    "name": "ecampus-monorepo",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "license": "MPL-2.0",
    "scripts": {
        "build": "pnpm --filter @concertypin/ecampus-crawler build && pnpm --filter @concertypin/kampus build",
        "dev": "pnpm --filter @concertypin/ecampus-crawler dev",
        "format": "prettier --write . --cache --list-different",
        "lint:check": "oxlint .",
        "lint": "oxlint . --fix",
        "test": "pnpm --filter @concertypin/ecampus-crawler test",
        "check": "pnpm run format && pnpm run lint && pnpm run test && git add -u",
        "pre-commit": "pnpm run check",
        "postinstall": "pnpm exec simple-git-hooks"
    },
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "@vitest/coverage-v8": "^4.1.6",
        "cross-env": "^10.1.0",
        "globals": "^17.6.0",
        "oxlint": "^1.66.0",
        "oxlint-tsgolint": "^0.23.0",
        "prettier": "^3.8.3",
        "simple-git-hooks": "^2.13.1",
        "typescript": "~6.0.3",
        "vite": "^8.0.13",
        "vite-plugin-dts": "^5.0.1",
        "vitest": "^4.1.6"
    },
    "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
