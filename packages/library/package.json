{
    "name": "@concertypin/ecampus-crawler",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "license": "MPL-2.0",
    "author": {
        "name": "concertypin",
        "url": "https://github.com/concertypin"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/concertypin/kampus.git",
        "directory": "packages/library"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*/index.d.ts",
            "import": "./dist/*/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "test": "vitest run"
    },
    "dependencies": {
        "consola": "^3.4.2",
        "linkedom": "^0.18.12"
    }
}
